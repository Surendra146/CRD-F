{
  "name": "cbd_p",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "lint": "eslint .",
    "preview": "vite preview --configLoader native",
    "test": "npm run build",
    "test:ci": "npm run test",
    "docker:dev": "docker compose --env-file .env.docker --profile dev up --build",
    "docker:test": "docker compose --env-file .env.docker --profile test run --build --rm backend-test && docker compose --env-file .env.docker --profile test run --build --rm frontend-test",
    "docker:prod": "docker compose --env-file .env.docker --profile prod up --build -d --wait",
    "docker:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-init.ps1",
    "docker:down": "docker compose --env-file .env.docker --profile dev --profile prod --profile test down",
    "docker:logs": "docker compose --env-file .env.docker --profile dev --profile prod logs -f"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "axios": "^1.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.553.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.6.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1"
  }
}
